# ─── Ghostty Config ───────────────────────────────────────────

# Theme
theme = Kanagawa Dragon

# Font
font-family = JetBrainsMono Nerd Font
font-size = 14

# Window
macos-titlebar-style = "transparent"
window-padding-balance = true
window-padding-x = 8
window-padding-y = 4
window-theme = "ghostty"
window-decoration = true
background-blur-radius = 10
background-opacity = 0.95
initial-window = true
quick-terminal-size = 100%

# Scroll
keybind = shift+up=scroll_page_up
keybind = shift+down=scroll_page_down

# Pass keys through to tmux/apps
keybind = ctrl+b=unbind
keybind = ctrl+j=unbind
keybind = ctrl+k=unbind
keybind = "global:ctrl+w=toggle_quick_terminal"

# ─── Splits (vim-style; ⌘ namespace never reaches tmux) ───
# Create
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
# Navigate (hjkl)
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right
# Resize (shift+hjkl)
keybind = super+shift+h=resize_split:left,10
keybind = super+shift+j=resize_split:down,10
keybind = super+shift+k=resize_split:up,10
keybind = super+shift+l=resize_split:right,10
# Zoom / equalize / close
keybind = super+shift+enter=toggle_split_zoom
keybind = super+ctrl+equal=equalize_splits
keybind = super+shift+w=close_surface

# Multi-line input for Claude Code
keybind = shift+enter=text:\n
